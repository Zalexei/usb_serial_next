<?xml version="1.0" encoding="utf-8"?>
<!-- Devices that start the app when plugged in. vendor-id and product-id are
     decimal. A vendor-id alone matches every product of that vendor. -->
<resources>
    <!-- FTDI (0x0403) -->
    <usb-device vendor-id="1027" />
    <!-- Silicon Labs CP210x (0x10C4) -->
    <usb-device vendor-id="4292" />
    <!-- WCH CH340/CH341/CH343/CH9102 (0x1A86) -->
    <usb-device vendor-id="6790" />
    <!-- Prolific PL2303 (0x067B) -->
    <usb-device vendor-id="1659" />
    <!-- Arduino (0x2341, 0x2A03) -->
    <usb-device vendor-id="9025" />
    <usb-device vendor-id="10755" />
    <!-- Espressif native USB: ESP32-S2, S3, C3, C6 (0x303A) -->
    <usb-device vendor-id="12346" />
    <!-- Raspberry Pi RP2040/RP2350 (0x2E8A) -->
    <usb-device vendor-id="11914" />
    <!-- STMicroelectronics virtual COM port (0x0483:0x5740) -->
    <usb-device vendor-id="1155" product-id="22336" />
</resources>
